<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
    <Metadata>
        <Identity Id="TableDiagramExtension.0d78cf91-8492-4f16-acdc-d27c716d3b03" Version="1.1" Language="en-US" Publisher="Bert O'Neill" />
        <DisplayName>TableDiagramExtension</DisplayName>
        <Description xml:space="preserve">This SSMS 'Table Diagram Extension' will quickly get the related tables to your selected table and create an ER diagram. Showing the references, prinary and foreign keys.
To which, you can export as an image to shqare or print out.

The concept is to get you up to speed on a section of the database schema - not all the schema at one, but creating bite size diagrams of related tables.</Description>
        <Icon>database_storage_server_network_file_icon_190636.ico</Icon>
        <Tags>SSMS Extension ERD Diagrams</Tags>
    </Metadata>
    <Installation>
    </Installation>
    <Dependencies>
        <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.5,)" />
    </Dependencies>
    <Prerequisites>
        <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,18.0)" DisplayName="Visual Studio core editor" />
    </Prerequisites>
    <Assets>
        <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    </Assets>
</PackageManifest>
